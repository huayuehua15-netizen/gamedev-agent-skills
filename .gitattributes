# 统一换行，避免 Windows 提交污染其他平台的 diff
* text=auto eol=lf

# 脚本保持 LF，确保在 Linux/macOS 上可直接执行
*.py    text eol=lf
*.sh    text eol=lf
*.ps1   text eol=crlf
*.md    text eol=lf
*.json  text eol=lf
*.csv   text eol=lf
*.cs    text eol=lf

# 二进制，不做任何转换
*.png   binary
*.jpg   binary
*.zip   binary
*.fbx   binary
*.blend binary
*.hdr   binary
